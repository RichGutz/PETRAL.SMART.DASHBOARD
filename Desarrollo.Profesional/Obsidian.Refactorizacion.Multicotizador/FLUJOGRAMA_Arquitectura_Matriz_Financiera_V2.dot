digraph MatrizFinanciera3PartesV2 {
    rankdir=TB;
    newrank=true;
    splines=polyline;
    nodesep=0.8;
    ranksep=1.5;
    
    node [shape=box, style="filled,rounded", fontname="Arial", fontsize=10, margin="0.18,0.14"];
    edge [fontname="Arial", fontsize=9];

    # ==========================================
    #  NIVEL 1: CAPA DE PERSISTENCIA (Supabase DB)
    # ==========================================
    subgraph cluster_lvl1 {
        label = "NIVEL 1: PERSISTENCIA Y MAESTROS (Supabase DB)"; 
        style="filled"; color="#37474F"; fillcolor="#F8FAFC";
        
        { rank=same; DB_Clients; DB_Contracts; DB_Quotes; DB_Vessels; }
        
        DB_Clients [label="👥 clients\n• Activos (is_prospect=false)\n• Prospectos (is_prospect=true)", shape=cylinder, fillcolor="#E0F2FE", penwidth=2];
        DB_Contracts [label="📜 contracts / routes_clients\n• Rutas fijas (port_a ➔ port_b)\n• Tarifas base y condiciones", shape=cylinder, fillcolor="#FFCDD2", penwidth=2];
        DB_Quotes [label="💼 routes_quotes\n• Cotizaciones comerciales guardadas\n• JSON legs_data completo autocontenido", shape=cylinder, fillcolor="#C8E6C9", penwidth=2];
        DB_Vessels [label="🚢 vessels\n• Flota (Specs, DWT, Velocidad)\n• Consumos Sea/Idle/Port y TCE Req", shape=cylinder, fillcolor="#FFE0B2", penwidth=2];

        DB_Clients -> DB_Contracts -> DB_Quotes -> DB_Vessels [style=invis];
    }

    # ==========================================
    #  NIVEL 2: ORQUESTADOR Y CONTEXTO GLOBAL
    # ==========================================
    subgraph cluster_lvl2 {
        label = "NIVEL 2: ORQUESTADOR Y MOTOR REACTIVO (ForecastContext_V2 / FastAPI Engine)"; 
        style="filled,dashed"; color="#0284C7"; fillcolor="#F0F9FF";
        
        { rank=same; Ctx_State; Engine_Calculate; }

        Ctx_State [label="🧠 ForecastContext_V2 (Estado Reactivo en Memoria)\n• Horizon (startDate / endDate) & dynamicMonths\n• projectionLines (Líneas activas proyectadas)\n• Visibilidad (hiddenClients, hiddenRoutes, hiddenVessels, hiddenMonths)\n• Bucle isDirty (Alerta de cambios pendientes)", shape=component, fillcolor="#BAE6FD", penwidth=2];
        Engine_Calculate [label="⚡ Motor de Cálculo Comercial (/forecast/calculate)\n• Agregación matricial pura: [cliente][ruta][buque][mes]\n• Cálculo exacto de Días, Búnker, Puertos, P&L y TCE\n• Emisión del contrato data.aggregated_data", shape=component, fillcolor="#D1C4E9", penwidth=2];

        Ctx_State -> Engine_Calculate [style=invis];
    }

    # ==========================================
    #  NIVEL 3: PARTE 2 — SELECTORES Y RIBBON DE CONSTRUCCIÓN
    # ==========================================
    subgraph cluster_lvl3 {
        label = "PARTE 2: SELECTORES Y RIBBON DE CONSTRUCCIÓN (ForecastBuilder.tsx)"; 
        style="filled"; color="#0F766E"; fillcolor="#F0FDFA";
        
        { rank=same; UI_Horizon; UI_ClientStep; UI_RouteStep; UI_VesselStep; UI_FreqDemurrage; UI_BtnAdd; }

        UI_Horizon [label="1-2. INICIO & FIN / 3. MESES\n• MonthPicker (Inicio y Fin)\n• Popover multiselección meses", shape=box, fillcolor="#CCFBF1"];
        UI_ClientStep [label="4. CLIENTE (Activos vs Prospectos)\n• [ ACTIVOS ] (Azul/Sky: SPCC, NEXA)\n• [ PROSPECTOS ] (Morado: MARCOBRE...)", shape=box, fillcolor="#E0E7FF", penwidth=2];
        UI_RouteStep [label="5. RUTA O COTIZACIÓN UNIFICADA\n• Fusión Pasos 2 y 3 Multicotizador\n• Rutas de Contrato + 💬 Cotizaciones", shape=box, fillcolor="#FEF3C7", penwidth=2];
        UI_VesselStep [label="6. BUQUE\n• MOQUEGUA, TABLONES,\nCONCON TRADER, HUEMUL", shape=box, fillcolor="#DCFCE7"];
        UI_FreqDemurrage [label="7. VIAJES & 8. DEMURRAGE (%)\n• Frecuencia mensual\n• Toggle Demurrage %", shape=box, fillcolor="#F1F5F9"];
        UI_BtnAdd [label="➕ AÑADIR AL MODELO\n• Inyecta en projectionLines\n• Dispara recálculo", shape=cds, fillcolor="#0D9488", fontcolor="white", penwidth=2];

        UI_Horizon -> UI_ClientStep -> UI_RouteStep -> UI_VesselStep -> UI_FreqDemurrage -> UI_BtnAdd [style=invis];
    }

    # ==========================================
    #  NIVEL 4: PARTE 1 — FILTROS DE TABLA Y EXPORTACIÓN
    # ==========================================
    subgraph cluster_lvl4 {
        label = "PARTE 1: FILTROS DE TABLA Y EXPORTACIÓN (ForecastGridFilters.tsx)"; 
        style="filled,dashed"; color="#C026D3"; fillcolor="#FDF4FF";
        
        { rank=same; Filter_Cascada; Filter_Estructura; Export_Actions; }

        Filter_Cascada [label="Filtros en Cascada (Checkboxes)\n• Clientes (Select All / Items)\n• Rutas (Grid 2 columnas)\n• Buques & Meses por Quarters (Q1..Q4)", shape=box, fillcolor="#FAE8FF"];
        Filter_Estructura [label="Toggles de Estructura\n• Subtotales Cliente\n• Acumulado Global", shape=box, fillcolor="#F3E8FF"];
        Export_Actions [label="Acciones de Exportación\n• 📄 PDF Vertical (Impresión A4)\n• 📄 PDF Horizontal (Apaisado A4)\n• 📊 a Excel (XLSX con formatos)", shape=box, fillcolor="#E879F9", fontcolor="white", penwidth=2];

        Filter_Cascada -> Filter_Estructura -> Export_Actions [style=invis];
    }

    # ==========================================
    #  NIVEL 5: PARTE 3 — GRILLA TABULAR FINANCIERA FIEL
    # ==========================================
    subgraph cluster_lvl5 {
        label = "PARTE 3: GRILLA TABULAR FINANCIERA FIEL (ForecastGrid.tsx + ForecastGrid.css)"; 
        style="filled"; color="#1E293B"; fillcolor="#F8FAFC";
        
        { rank=same; Grid_GroupOrder; Grid_MainMetrics; Grid_SubRows; Grid_Totals; }

        Grid_GroupOrder [label="Reagrupamiento Dinámico (groupOrder)\n• Permutador Cliente ⇄ Ruta ⇄ Buque\n• Insignias de Color semánticas\n• Selector in-situ de buque por fila", shape=box, fillcolor="#E2E8F0", penwidth=2];
        Grid_MainMetrics [label="10 Métricas Principales Consolidadas\n• Viajes (freq), Toneladas, Gross Revenue\n• Comisiones, Net Freight, Port Costs\n• Bunker Costs, Voyage Result, TCE, P/L", shape=box, fillcolor="#FEF08A", penwidth=2];
        Grid_SubRows [label="24 Sub-Filas Desplegables ([▶] en Viajes)\n• Distancias, Días Mar/Puerto, Duración Total\n• IFO & MDO (Consumo, Precio $/T, Costo $)\n• Carga por viaje, Flete Base, Comisiones\n• Edición In-Situ de Frecuencia, Flete y Búnker", shape=box, fillcolor="#FEF9C3"];
        Grid_Totals [label="Filas de Consolidación y Cierre\n• Subtotales por Cliente\n• Total General de Cartera\n• Acumulado Global Mes a Mes", shape=box, fillcolor="#BBF7D0", penwidth=2];

        Grid_GroupOrder -> Grid_MainMetrics -> Grid_SubRows -> Grid_Totals [style=invis];
    }

    # ==========================================
    #  APILAMIENTO VERTICAL (TOP-TO-BOTTOM)
    # ==========================================
    DB_Clients -> Ctx_State -> UI_ClientStep -> Filter_Cascada -> Grid_GroupOrder [style=invis, weight=100];

    # ==========================================
    #  CONEXIONES FUNCIONALES
    # ==========================================
    
    # DB a Contexto y Selectores
    DB_Clients -> UI_ClientStep [label=" Activos vs Prospectos"];
    DB_Contracts -> UI_RouteStep [label=" Rutas port_a ➔ port_b"];
    DB_Quotes -> UI_RouteStep [label=" Cotizaciones guardadas"];
    DB_Vessels -> UI_VesselStep [label=" Catálogo buques"];

    # Selectores a Contexto
    UI_BtnAdd -> Ctx_State [label=" onAddLine()", color="#0D9488", penwidth=2];
    Ctx_State -> Engine_Calculate [label=" projectionLines", color="#0284C7", penwidth=2];
    Engine_Calculate -> Ctx_State [label=" data.aggregated_data", color="#0284C7", penwidth=2];

    # Filtros de Tabla
    Ctx_State -> Filter_Cascada [label=" clientList, routeList, vesselList"];
    Filter_Cascada -> Ctx_State [label=" setHiddenClients, etc."];
    Filter_Actions -> Export_Actions [style=invis];

    # Grilla Tabular
    Ctx_State -> Grid_GroupOrder [label=" Inyección de data", color="#1E293B", penwidth=2];
    Grid_SubRows -> Ctx_State [label=" Edición in-situ (onFrequency, onTariff, onBunker) ➔ Activa isDirty", color="#DC2626", penwidth=2];
    Grid_GroupOrder -> Grid_MainMetrics -> Grid_SubRows -> Grid_Totals [style=dashed];
}
