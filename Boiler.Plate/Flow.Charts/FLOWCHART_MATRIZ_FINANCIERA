
    digraph MatrizFinanciera {
        rankdir=TB; splines=ortho; nodesep=1.8; ranksep=3.2; dpi=300; newrank=true;
        node [shape=box, style="filled,rounded", fontname="Arial Bold", fontsize=22, height=1.3, margin="0.5,0.4"];
        edge [fontname="Arial Bold", fontsize=16, penwidth=2.5];

        subgraph cluster_origen {
            label = "ORIGEN: VIAJES EXPORTADOS DESDE MULTICOTIZADOR";
            style="filled"; fillcolor="#EFF6FF"; color="#2563EB"; fontcolor="#1E3A5F"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                ViajeA [label="📦 VIAJE EXPORTADO A\n(Cliente, Ruta, Fecha, P&L)", fillcolor="#DBEAFE", shape=note, fontsize=20];
                ViajeB [label="📦 VIAJE EXPORTADO B\n(Cliente, Ruta, Fecha, P&L)", fillcolor="#DBEAFE", shape=note, fontsize=20];
                ViajeN [label="📦 VIAJE EXPORTADO N\n(Cliente, Ruta, Fecha, P&L)", fillcolor="#DBEAFE", shape=note, fontsize=20];
            }
            ViajeA -> ViajeB -> ViajeN [style=invis, weight=30];
        }

        subgraph cluster_grilla {
            label = "MATRIZ FINANCIERA: GRILLA MENSUAL MULTI-CLIENTE";
            style="filled,dashed"; fillcolor="#FFF7ED"; color="#F97316"; fontcolor="#431407"; fontname="Arial Bold"; fontsize=26;
            Grilla [label="📋 GRILLA MENSUAL\nFilas = Clientes Comerciales\nColumnas = Meses del Horizonte\nCeldas = Σ Viajes Exportados\n(Ingreso / Bunker / Puertos / P&L)", shape=doubleoctagon, fillcolor="#FED7AA", penwidth=3.0, fontsize=22, height=2.8];
        }

        subgraph cluster_vistas {
            label = "VISTAS DISPONIBLES EN EL VISOR";
            style="filled,dashed"; fillcolor="#F0FDF4"; color="#16A34A"; fontcolor="#14532D"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                VistaGrid    [label="📊 VISTA GRILLA\n(Tabla Interactiva editable\npor Cliente y Mes)", fillcolor="#DCFCE7"];
                VistaGrafico [label="📈 VISTA GRÁFICO\n(Bar Chart P&L\npor Cliente o por Mes)", fillcolor="#DCFCE7"];
                VistaLedger  [label="🧪 AUDITORÍA LEDGER\n(Desglose por Viaje individual\ncon rastro de cálculo)", fillcolor="#DCFCE7"];
            }
            VistaGrid -> VistaGrafico -> VistaLedger [style=invis, weight=30];
        }

        subgraph cluster_acciones {
            label = "ACCIONES DEL OPERADOR";
            style="filled,dashed"; fillcolor="#F8FAFC"; color="#475569"; fontcolor="#0F172A"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                AccGuardar   [label="💾 GUARDAR\n(Snapshot del Forecast)", fillcolor="#F1F5F9", fontsize=20, shape=cds];
                AccCargar    [label="📂 CARGAR\n(Forecast guardado previo)", fillcolor="#F1F5F9", fontsize=20, shape=cds];
                AccFiltrar   [label="🔍 FILTRAR\n(Por Cliente, Mes,\nBuque o Ruta)", fillcolor="#E2E8F0", fontsize=20, shape=cds];
            }
            AccGuardar -> AccCargar -> AccFiltrar [style=invis, weight=30];
        }

        subgraph cluster_salida {
            label = "SALIDAS Y CONEXIÓN CON AUDITORÍA";
            style="filled,dashed"; fillcolor="#E2E8F0"; color="#64748B"; fontcolor="#0F172A"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                SalidaExcel  [label="📈 EXPORT EXCEL\n(Matriz completa con\ntodos los detalles)", fillcolor="#F1F5F9", fontsize=20];
                SalidaAudit  [label="🔍 IR A AUDITORÍA DUAL\n(Validar viaje específico\ncontra factura del armador)", fillcolor="#CBD5E1", fontsize=20];
            }
            SalidaExcel -> SalidaAudit [style=invis, weight=30];
        }

        ViajeA -> Grilla; ViajeB -> Grilla; ViajeN -> Grilla;
        Grilla -> VistaGrid [style=invis, weight=10];
        Grilla -> VistaGrid; Grilla -> VistaGrafico; Grilla -> VistaLedger;
        VistaGrid -> AccGuardar [style=invis, weight=10];
        VistaGrid -> AccGuardar; VistaGrid -> AccCargar; VistaGrid -> AccFiltrar;
        AccGuardar -> SalidaExcel [style=invis, weight=10];
        VistaLedger -> SalidaAudit;
        AccGuardar -> SalidaExcel;
    }
    
