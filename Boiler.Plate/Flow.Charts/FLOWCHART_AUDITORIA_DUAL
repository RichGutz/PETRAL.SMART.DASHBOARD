
    digraph AuditoriaDual {
        rankdir=TB; splines=ortho; nodesep=1.8; ranksep=3.2; dpi=300; newrank=true;
        node [shape=box, style="filled,rounded", fontname="Arial Bold", fontsize=22, height=1.3, margin="0.5,0.4"];
        edge [fontname="Arial Bold", fontsize=16, penwidth=2.5];

        subgraph cluster_inputs {
            label = "INPUTS: DOCUMENTOS A AUDITAR";
            style="filled"; fillcolor="#EFF6FF"; color="#2563EB"; fontcolor="#1E3A5F"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                PdfArmador [label="📄 PDF ARMADOR\n(Factura / SOF del Armador\ncon ítems de costos)", fillcolor="#DBEAFE", shape=note];
                PdfAgente  [label="📄 PDF AGENTE PORTUARIO\n(Cuenta de Gastos del Agente\nPor Puerto Carga & Descarga)", fillcolor="#DBEAFE", shape=note];
            }
            PdfArmador -> PdfAgente [style=invis, weight=50];
        }

        subgraph cluster_viewer {
            label = "HERRAMIENTA AUDITORÍA DUAL — VISOR SPLIT-VIEW";
            style="filled,dashed"; fillcolor="#FEF3C7"; color="#D97706"; fontcolor="#78350F"; fontname="Arial Bold"; fontsize=26;
            SplitView [label="🔍 VISOR SPLIT-VIEW\n(PDF Armador | PDF Agente\nAmpliar, Navegar, Comparar)", shape=doubleoctagon, fillcolor="#FDE68A", penwidth=3.0, fontsize=22, height=2.2];
        }

        subgraph cluster_calculo {
            label = "VALORES CALCULADOS POR EL SISTEMA (Para Comparación)";
            style="filled,dashed"; fillcolor="#F3E8FF"; color="#9333EA"; fontcolor="#3B0764"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                CalcP [label="⚙️ P CALCULADO\n(Precio Bunker VLSFO/LSMGO\ndel Maestro de Bunkers)", fillcolor="#E9D5FF", fontsize=20];
                CalcQ [label="📐 Q CALCULADO\n(Consumo MT por Día × Días\nvía Spot Calculator)", fillcolor="#E9D5FF", fontsize=20];
                CalcG [label="🏭 GASTOS PORTUARIOS\n(Motor Dedicado por Puerto\nvía Core Dispatcher)", fillcolor="#E9D5FF", fontsize=20];
            }
            CalcP -> CalcQ -> CalcG [style=invis, weight=30];
        }

        subgraph cluster_comparacion {
            label = "COMPARACIÓN: FACTURA vs CÁLCULO SISTEMA";
            style="filled,dashed"; fillcolor="#CCFBF1"; color="#0D9488"; fontcolor="#042F2E"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                DeltaBunker [label="Δ BUNKER\nFactura vs Sistema\n(USD & %)", fillcolor="#99F6E4", shape=diamond, height=2.0, fontsize=20];
                DeltaPuerto [label="Δ PUERTOS\nFactura vs Sistema\n(USD & %)", fillcolor="#99F6E4", shape=diamond, height=2.0, fontsize=20];
                DeltaTotal  [label="Δ TOTAL P&L\nImpacto Net Final\n(USD & USD/MT)", fillcolor="#99F6E4", shape=diamond, height=2.0, fontsize=20];
            }
            DeltaBunker -> DeltaPuerto -> DeltaTotal [style=invis, weight=30];
        }

        subgraph cluster_salida {
            label = "RESOLUCIÓN Y DOCUMENTACIÓN";
            style="filled,dashed"; fillcolor="#E2E8F0"; color="#64748B"; fontcolor="#0F172A"; fontname="Arial Bold"; fontsize=26;
            { rank=same;
                AccAprobado [label="✅ APROBADO\n(Δ dentro de tolerancia\nFactura OK)", fillcolor="#DCFCE7", fontsize=20, shape=cds];
                AccObjecion [label="⚠️ OBJECIÓN\n(Δ supera tolerancia\nNota de Crédito requerida)", fillcolor="#FEE2E2", fontsize=20, shape=cds];
                ActaPdf     [label="📄 ACTA AUDITORÍA PDF\n(Reporte firmable con\ndesglose completo)", fillcolor="#F1F5F9", fontsize=20];
            }
            AccAprobado -> AccObjecion -> ActaPdf [style=invis, weight=30];
        }

        PdfArmador -> SplitView; PdfAgente -> SplitView;
        SplitView -> CalcP [style=invis, weight=10];
        SplitView -> DeltaBunker;
        CalcP -> DeltaBunker; CalcQ -> DeltaBunker;
        CalcG -> DeltaPuerto;
        DeltaBunker -> DeltaTotal; DeltaPuerto -> DeltaTotal;
        DeltaTotal -> AccAprobado [style=invis, weight=10];
        DeltaTotal -> AccAprobado; DeltaTotal -> AccObjecion;
        AccAprobado -> ActaPdf; AccObjecion -> ActaPdf;
    }
    
